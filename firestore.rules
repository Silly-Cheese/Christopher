rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeStaff() {
      return signedIn()
        && userRecord().data.active == true
        && userRecord().data.role in ['owner', 'admin', 'editor'];
    }

    function administrator() {
      return signedIn()
        && userRecord().data.active == true
        && userRecord().data.role in ['owner', 'admin'];
    }

    function owner() {
      return signedIn()
        && userRecord().data.active == true
        && userRecord().data.role == 'owner';
    }

    match /sermons/{sermonId} {
      allow read: if resource.data.status == 'published' || activeStaff();
      allow create, update: if activeStaff();
      allow delete: if administrator();
    }

    match /series/{seriesId} {
      allow read: if resource.data.published == true || activeStaff();
      allow create, update: if activeStaff();
      allow delete: if administrator();
    }

    match /resources/{resourceId} {
      allow read: if resource.data.status == 'published' || activeStaff();
      allow create, update: if activeStaff();
      allow delete: if administrator();
    }

    match /readingPlans/{planId} {
      allow read: if resource.data.status == 'published' || activeStaff();
      allow create, update: if activeStaff();
      allow delete: if administrator();
    }

    match /contentViews/{counterId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          'contentType', 'contentId', 'views', 'lastViewedAt'
        ])
        && request.resource.data.contentType in ['resource', 'readingPlan']
        && request.resource.data.contentId is string
        && request.resource.data.views == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['views', 'lastViewedAt'])
        && request.resource.data.views == resource.data.views + 1;
      allow delete: if administrator();
    }

    match /topics/{topicId} {
      allow read: if true;
      allow create, update: if activeStaff();
      allow delete: if administrator();
    }

    match /siteSettings/{documentId} {
      allow read: if true;
      allow write: if administrator();
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || administrator());
      allow create: if owner();
      allow update: if owner()
        || (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'updatedAt']));
      allow delete: if owner() && request.auth.uid != userId;
    }
  }
}
